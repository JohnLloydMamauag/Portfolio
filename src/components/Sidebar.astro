---
import { site, nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sidebar">
  <div class="sidebar__inner">
    <div class="profile">
      <div class="avatar">
        <span class="avatar__ring" aria-hidden="true"></span>
        <span class="avatar__frame">
          <img
            src="/img/john-lloyd.png"
            alt={`${site.name}, ${site.role}`}
            width="560"
            height="560"
            fetchpriority="high"
            decoding="async"
          />
        </span>
      </div>

      <div class="profile__text">
        <h2 class="profile__name">
          <span>{site.name}</span>
          <span class="verified" aria-hidden="true">
            <i class="ph-fill ph-seal-check"></i>
          </span>
          <span class="sr-only">(verified)</span>
        </h2>
        <p class="profile__base">
          <i class="ph ph-map-pin" aria-hidden="true"></i>
          <span>{site.base}</span>
        </p>
        <p class="profile__role">{site.role}</p>
      </div>
    </div>

    <div class="socials">
      {
        site.socials.map((s) => (
          <a class="social" href={s.href} target="_blank" rel="noopener noreferrer" title={s.label}>
            <i class={`ph ${s.icon}`} aria-hidden="true"></i>
            <span class="sr-only">{s.label}</span>
          </a>
        ))
      }
    </div>

    <nav class="nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav__link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <i class={`ph ${item.icon}`} aria-hidden="true"></i>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="sidebar__foot">
      <a class="btn btn--ghost sidebar__cta" href="/contact">
        <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>
        Get in touch
      </a>
      <p class="copyright">© {new Date().getFullYear()} {site.name}</p>
    </div>
  </div>
</header>

<style>
  .sidebar {
    position: sticky;
    top: 1.75rem;
    align-self: start;
    height: calc(100vh - 3.5rem);
  }

  .sidebar__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* Sized to fit the viewport in one piece — the rail never scrolls. */
    gap: clamp(.85rem, 1.6vh, 1.4rem);
    padding: clamp(1rem, 2.2vh, 1.6rem) 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .profile { text-align: center; }

  /* The frame clips the portrait; the ring sits outside it so it isn't cut off. */
  .avatar {
    position: relative;
    width: clamp(88px, 15.5vh, 160px);
    height: clamp(88px, 15.5vh, 160px);
    margin: 0 auto .75rem;
    flex: none;
  }

  .avatar__frame {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(150deg, var(--g-600), var(--g-800));
    box-shadow: 0 0 0 6px rgba(2, 51, 54, .10);
  }

  .avatar__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
  }

  .avatar__ring {
    position: absolute;
    inset: -11px;
    border-radius: 50%;
    border: 2px dashed rgba(2, 51, 54, .28);
    animation: spin 22s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .profile__name {
    font-size: clamp(1.05rem, 1.9vh, 1.2rem);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: .4rem;
  }

  /* White disc behind the seal so the cut-out check reads white, Facebook-style. */
  .verified {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.15em;
    height: 1.15em;
    flex: none;
  }
  .verified::before {
    content: '';
    position: absolute;
    width: .55em;
    height: .55em;
    border-radius: 50%;
    background: #fff;
  }
  .verified i {
    position: relative;
    font-size: 1.15em;
    color: var(--verified);
  }

  .profile__base {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    color: var(--text-dim);
    font-size: .875rem;
    margin-top: .1rem;
  }

  .profile__role {
    margin-top: .45rem;
    font-size: .825rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: .5rem;
    padding-bottom: clamp(.7rem, 1.6vh, 1.2rem);
    border-bottom: 1px solid var(--border);
  }

  .social {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    font-size: 1.2rem;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border);
    transition: transform .3s ease, background-color .3s ease, color .3s ease;
  }
  .social:hover { transform: translateY(-4px); background: var(--accent); color: var(--accent-ink); }

  .nav ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: clamp(.15rem, .55vh, .35rem); }

  .nav__link {
    display: flex;
    align-items: center;
    gap: .8rem;
    padding: clamp(.55rem, 1.25vh, .8rem) 1rem;
    border-radius: var(--radius-sm);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-muted);
    border: 1px solid transparent;
    transition: background-color .28s ease, color .28s ease, transform .28s ease, border-color .28s ease;
  }
  .nav__link i { font-size: 1.3rem; }
  .nav__link:hover { color: var(--text); background: var(--surface-2); transform: translateX(4px); }
  .nav__link.is-active {
    color: var(--text);
    background: var(--surface-2);
    border-color: var(--border-strong);
    font-weight: 600;
  }
  .nav__link.is-active i { color: var(--accent); }

  .sidebar__foot { margin-top: auto; display: grid; gap: .6rem; }
  .sidebar__cta { justify-content: center; width: 100%; padding: .7rem 1.2rem; font-size: .95rem; }
  .copyright { text-align: center; font-size: .78rem; color: var(--text-dim); }

  /* ============ Tablet / mobile ============ */
  @media (max-width: 1040px) {
    .sidebar { position: static; height: auto; }

    .sidebar__inner {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      padding: 1rem 1.1rem;
      overflow: visible;
    }

    /* Profile becomes a compact identity row instead of a tall column. */
    .profile {
      display: flex;
      align-items: center;
      gap: .9rem;
      text-align: left;
      flex: 1 1 260px;
      min-width: 0;
    }
    .avatar { width: 76px; height: 76px; margin: 0; }
    .avatar__ring { inset: -6px; }
    .profile__text { min-width: 0; }
    .profile__name { font-size: 1.05rem; justify-content: flex-start; gap: .3rem; }
    .profile__base { font-size: .85rem; justify-content: flex-start; }
    .profile__role { margin-top: .2rem; font-size: .8rem; line-height: 1.45; }

    .socials { padding-bottom: 0; border-bottom: 0; gap: .45rem; margin-left: auto; }
    .social { width: 44px; height: 44px; font-size: 1.2rem; }
    .social:hover { transform: none; }

    .sidebar__foot { margin-top: 0; width: 100%; }
    .sidebar__cta { width: auto; justify-self: start; }
    .copyright { text-align: left; }

    /* Primary nav moves to a thumb-reachable bottom bar. */
    .nav {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 60;
      background: color-mix(in srgb, var(--surface) 92%, transparent);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-top: 1px solid var(--border);
      padding: .35rem .4rem calc(.35rem + env(safe-area-inset-bottom));
    }
    .nav ul { flex-direction: row; justify-content: space-around; gap: 0; }
    .nav li { flex: 1 1 0; }
    .nav__link {
      flex-direction: column;
      gap: .1rem;
      min-height: 54px;
      padding: .45rem .2rem;
      font-size: .72rem;
      line-height: 1.3;
      text-align: center;
      border-radius: 12px;
      border-color: transparent;
    }
    .nav__link i { font-size: 1.5rem; }
    .nav__link:hover { transform: none; background: transparent; }
    .nav__link.is-active { background: transparent; border-color: transparent; color: var(--accent); }
  }

  @media (max-width: 560px) {
    .profile { flex: 1 1 100%; }
    .socials { margin-left: 0; width: 100%; justify-content: flex-start; }
    .sidebar__foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .75rem;
      flex-wrap: wrap;
    }
    .copyright { font-size: .78rem; }
  }
</style>
