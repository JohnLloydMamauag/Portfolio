---
import icons from '../data/brand-icons.json';
import { tools } from '../data/site';

type Icon = { body: string; vb: string };
const brand = icons as Record<string, Icon>;

const marks: Record<string, Icon> = { ...brand };
// Rendered twice so the track can loop seamlessly.
const track = [...tools, ...tools];
---

<section class="marquee card reveal" aria-labelledby="tools-heading">
  <div class="marquee__label">
    <p class="eyebrow">Daily drivers</p>
    <h2 id="tools-heading" class="marquee__title">Tools I work with</h2>
  </div>

  <div class="marquee__viewport">
    <ul class="marquee__track">
      {
        track.map((tool, i) => (
          <li class="tool" aria-hidden={i >= tools.length ? 'true' : undefined}>
            <span class="tool__icon">
              {tool.logo ? (
                <img src={tool.logo} alt={`${tool.name} logo`} width="34" height="34" loading="lazy" decoding="async" />
              ) : (
                <svg viewBox={marks[tool.id].vb} role="img" aria-label={`${tool.name} logo`} set:html={marks[tool.id].body} />
              )}
            </span>
            <span class="tool__name">{tool.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .marquee {
    display: grid;
    grid-template-columns: minmax(180px, 230px) minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
  }

  .marquee__title { font-size: 1.2rem; margin-top: .15rem; }

  .marquee__viewport {
    overflow: hidden;
    position: relative;
    padding-block: .35rem;
    border-left: 1px solid var(--border);
    padding-left: 1.5rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    align-items: center;
    gap: 2.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
    width: max-content;
    animation: slide 34s linear infinite;
    /* Runs continuously — hover and focus never pause it. */
    animation-play-state: running !important;
  }

  @keyframes slide {
    /* The track holds two identical halves, so -50% is one seamless lap. */
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  .tool {
    display: flex;
    align-items: center;
    gap: .7rem;
    white-space: nowrap;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color .3s ease;
  }
  .tool:hover { color: var(--text); }

  .tool__icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
  }
  .tool__icon :global(svg),
  .tool__icon img { width: 100%; height: 100%; object-fit: contain; }

  @media (max-width: 760px) {
    .marquee { grid-template-columns: 1fr; gap: .9rem; }
    .marquee__viewport { border-left: 0; padding-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; }
    .marquee__viewport { overflow-x: auto; }
  }
</style>
