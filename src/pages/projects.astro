---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import WorkCarouselModal from '../components/WorkCarouselModal';
import { galleries } from '../data/work';
import { site } from '../data/site';

const total = galleries.reduce((n, g) => n + g.shots.length, 0);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Projects',
    url: `${site.url}/projects`,
    about: 'GoHighLevel automation, funnel and social media marketing work',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: galleries.length,
      itemListElement: galleries.map((g, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          name: g.title,
          description: g.blurb,
          image: g.shots.map((s) => new URL(s.src, site.url).href),
        },
      })),
    },
  },
];
---

<Base
  title="Projects"
  description="GoHighLevel automations, funnels and social media work by John Lloyd Mamauag. Open any card to page through screenshots of the real builds."
  keywords={['GHL workflow examples', 'funnel screenshots', 'social media portfolio']}
  schema={schema}
>
  <div class="projects-page">
  <PageHeader
    eyebrow="Selected work"
    title="Real builds, real screenshots"
    lead={`Three areas of work, ${total} pieces straight out of the accounts I built them in. Open a card to page through the gallery.`}
  />

  <div class="rail-wrap" data-rail-wrap>
  <ul class="rail" data-rail tabindex="0" aria-label="Work galleries">
    {
      galleries.map((g, i) => (
        <li>
          <Fragment>
            {(() => {
              const Tag = g.shots.length ? 'button' : 'div';
              return (
                <Tag
                  class:list={['card', 'work', { 'work--empty': !g.shots.length }]}
                  type={g.shots.length ? 'button' : undefined}
                  data-gallery={g.shots.length ? g.id : undefined}
                  style={`--delay:${i * 90}ms`}
                >
            <span class="work__shots" aria-hidden="true">
              {g.shots.length ? (
                g.shots.slice(0, 3).map((shot, n) => (
                  <img src={shot.thumb} alt="" loading="lazy" decoding="async" style={`--n:${n}`} />
                ))
              ) : (
                <span class="work__placeholder">
                  <i class="ph ph-image-square" aria-hidden="true" />
                </span>
              )}
            </span>

            <span class="card-head">
              <span class="badge-icon">
                <i class={`ph ${g.icon}`} aria-hidden="true" />
              </span>
              <span>
                <span class="work__title">{g.title}</span>
                <span class="work__kind">{g.kind}</span>
              </span>
            </span>

            <span class="work__blurb">{g.blurb}</span>

            <span class="work__tags">
              {g.highlights.map((h) => (
                <span>{h}</span>
              ))}
            </span>

            <span class="work__cta">
              {g.shots.length ? (
                <>
                  <i class="ph-bold ph-images" aria-hidden="true" />
                  View {g.shots.length} screenshots
                  <i class="ph-bold ph-arrow-right work__arrow" aria-hidden="true" />
                </>
              ) : (
                <>
                  <i class="ph-bold ph-clock" aria-hidden="true" />
                  Screenshots coming soon
                </>
              )}
            </span>
                </Tag>
              );
            })()}
          </Fragment>
        </li>
      ))
    }
  </ul>

    <button class="rail-nav rail-nav--prev" type="button" data-rail-prev aria-label="Previous">
      <i class="ph-bold ph-caret-left" aria-hidden="true"></i>
    </button>
    <button class="rail-nav rail-nav--next" type="button" data-rail-next aria-label="Next">
      <i class="ph-bold ph-caret-right" aria-hidden="true"></i>
    </button>

    <div class="rail-dots" data-rail-dots>
      {
        galleries.map((g, i) => (
          <button type="button" data-rail-dot={i} aria-label={`Go to ${g.title}`} />
        ))
      }
    </div>
  </div>

  <section class="card cta reveal">
    <p><strong>Want something like this running in your business?</strong></p>
    <a class="btn" href="/contact"><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i> Start a project</a>
  </section>
  </div>

  <WorkCarouselModal
    client:load
    galleries={galleries.map((g) => ({ id: g.id, title: g.title, shots: g.shots }))}
  />
</Base>

<script>
  // Bound on every navigation, since the ClientRouter runs this module once.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-rail-wrap]').forEach((wrap) => {
      const rail = wrap.querySelector<HTMLElement>('[data-rail]');
      const prev = wrap.querySelector<HTMLButtonElement>('[data-rail-prev]');
      const next = wrap.querySelector<HTMLButtonElement>('[data-rail-next]');
      const dots = [...wrap.querySelectorAll<HTMLButtonElement>('[data-rail-dot]')];
      if (!rail || !prev || !next) return;

      const cards = rail.children as HTMLCollectionOf<HTMLElement>;
      // Distance from one card to the next, gap included.
      const step = () =>
        cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : rail.clientWidth;

      const update = () => {
        const max = rail.scrollWidth - rail.clientWidth;
        wrap.classList.toggle('is-scrollable', max > 4);
        prev.disabled = rail.scrollLeft <= 4;
        next.disabled = rail.scrollLeft >= max - 4;

        // A dot per scroll position, not per card: with three cards in view a
        // four-card rail only has two places to stop.
        const stops = Math.round(max / step()) + 1;
        const here = Math.round(rail.scrollLeft / step());
        dots.forEach((dot, i) => {
          dot.hidden = i >= stops;
          dot.setAttribute('aria-current', String(i === here));
        });
      };

      prev.addEventListener('click', () => rail.scrollBy({ left: -step() }));
      next.addEventListener('click', () => rail.scrollBy({ left: step() }));
      dots.forEach((dot, i) =>
        dot.addEventListener('click', () => rail.scrollTo({ left: i * step() })),
      );

      rail.addEventListener('scroll', update, { passive: true });
      new ResizeObserver(update).observe(rail);
      update();
    });
  });
</script>

<style>
  /*
   * The cards sit on a horizontal snap rail rather than a wrapping grid, so a
   * fourth (or fifth) gallery is a swipe away instead of a second row.
   */
  .rail-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    min-width: 0;
  }

  .rail {
    --gap: 1.25rem;
    list-style: none;
    margin: 0;
    /* Room for the cards' hover lift and shadow, which the scroll box clips. */
    padding: .5rem .25rem .85rem;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .rail::-webkit-scrollbar { display: none; }
  .rail:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 14px; }

  .rail > li {
    flex: 0 0 min(86%, 340px);
    scroll-snap-align: start;
    display: flex;
    min-width: 0;
  }
  @media (min-width: 720px) {
    .rail > li { flex-basis: calc((100% - var(--gap)) / 2); }
  }
  @media (min-width: 1041px) {
    .rail > li { flex-basis: calc((100% - 2 * var(--gap)) / 3); }
  }

  /* Arrows and dots only earn their space once the rail actually overflows. */
  .rail-nav, .rail-dots { display: none; }
  .rail-wrap.is-scrollable .rail-dots { display: flex; }

  .rail-nav {
    position: absolute;
    top: calc(50% - 1.5rem);
    z-index: 3;
    width: 3rem;
    height: 3rem;
    display: none;
    place-items: center;
    border-radius: 999px;
    /* The button straddles the pale card and the deep teal page behind it, so
       it carries both a pale fill and a dark ring to read against either. */
    border: 2px solid var(--g-900);
    background: var(--g-100);
    color: var(--g-900);
    font-size: 1.35rem;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(2, 51, 54, .5);
    transition: transform .2s ease, opacity .2s ease, background .2s ease;
  }
  .rail-nav:hover { background: var(--accent); transform: scale(1.08); }
  .rail-nav:focus-visible { outline: 3px solid var(--g-100); outline-offset: 3px; }
  .rail-nav[disabled] { opacity: .3; pointer-events: none; }
  .rail-nav--prev { left: -1rem; }
  .rail-nav--next { right: -1rem; }
  @media (min-width: 900px) {
    .rail-wrap.is-scrollable .rail-nav { display: grid; }
  }

  .rail-dots {
    justify-content: center;
    gap: .45rem;
  }
  .rail-dots button {
    width: .5rem;
    height: .5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--border-strong);
    cursor: pointer;
    transition: width .25s ease, background .25s ease;
  }
  .rail-dots button[aria-current='true'] {
    width: 1.5rem;
    background: var(--accent);
  }

  .work {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: .85rem;
    width: 100%;
    text-align: left;
    cursor: pointer;
    padding: 1.25rem;
  }

  /* Fanned preview of the first three screenshots. */
  .work__shots {
    position: relative;
    display: block;
    height: 172px;
    margin-bottom: .35rem;
  }
  .work__shots img {
    position: absolute;
    top: calc(var(--n) * 10px);
    left: 50%;
    width: 84%;
    height: 148px;
    object-fit: cover;
    object-position: top center;
    border-radius: 10px;
    border: 1px solid rgba(2, 51, 54, .22);
    box-shadow: 0 10px 24px rgba(2, 51, 54, .22);
    transform: translateX(-50%) rotate(calc((var(--n) - 1) * 3deg)) translateY(calc(var(--n) * -4px));
    transform-origin: bottom center;
    transition: transform .45s cubic-bezier(.2, .8, .3, 1);
  }
  .work__shots img:nth-child(1) { z-index: 1; }
  .work__shots img:nth-child(2) { z-index: 2; }
  .work__shots img:nth-child(3) { z-index: 3; }

  .work:hover .work__shots img:nth-child(1) { transform: translateX(calc(-50% - 30px)) rotate(-6deg); }
  .work:hover .work__shots img:nth-child(2) { transform: translateX(-50%) rotate(0deg) translateY(-8px); }
  .work:hover .work__shots img:nth-child(3) { transform: translateX(calc(-50% + 30px)) rotate(6deg); }

  .card-head { align-items: center; margin-bottom: 0; }
  .work__title { display: block; font-size: 1.15rem; font-weight: 700; }
  .work__kind { display: block; font-size: .8125rem; color: var(--text-dim); }

  .work__blurb { color: var(--text-muted); font-size: .95rem; line-height: 1.6; }

  /* A card with no screenshots yet is inert rather than a dead click target. */
  .work--empty { cursor: default; }
  .work--empty:hover { transform: none; box-shadow: none; }
  .work--empty .work__cta { color: var(--text-dim); }
  .work__placeholder {
    position: absolute;
    inset: 0 8%;
    display: grid;
    place-items: center;
    border-radius: 10px;
    border: 2px dashed var(--border-strong);
    background: var(--surface-2);
    color: var(--text-dim);
    font-size: 2.2rem;
  }

  .work__tags { display: flex; flex-wrap: wrap; gap: .4rem; }
  .work__tags span {
    padding: .3rem .7rem;
    border-radius: 999px;
    font-size: .78rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .work__cta {
    margin-top: auto;
    padding-top: .85rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .925rem;
    font-weight: 600;
    color: var(--accent);
  }
  .work__arrow { margin-left: auto; transition: transform .3s ease; }
  .work:hover .work__arrow { transform: translateX(4px); }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }
  .cta p { font-size: 1.05rem; }

  /*
   * On a desktop-sized window the whole page is sized to the viewport so a
   * visitor sees all three cards without scrolling. Narrow or short windows
   * fall back to normal document flow.
   */
  @media (min-width: 1041px) and (min-height: 660px) {
    .projects-page {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: 1rem;
      /* min-height, not height: if the copy genuinely does not fit the window
         the page grows and scrolls instead of slicing the cards. */
      min-height: calc(100vh - 3.5rem);
    }
    .projects-page :global(.page-header) { padding-top: 0; gap: .35rem; }
    .projects-page :global(.page-header h1) { font-size: clamp(1.9rem, 2.2vw + .9rem, 2.6rem); }
    .projects-page :global(.page-header .lead) { font-size: 1rem; max-width: 78ch; }

    .rail-wrap { min-height: 0; }
    .rail { min-height: 0; flex: 1 1 auto; }
    .rail > li { min-height: 0; }
    .work { height: 100%; min-height: 0; gap: .7rem; }

    /* Only the preview flexes. The text blocks hold their natural height so
       the leftover space is taken out of the screenshots, never out of a
       half-cut line of copy. */
    .work__shots { flex: 1 1 0; height: auto; min-height: 84px; margin-bottom: 0; }
    .work__shots img { height: 88%; top: calc(var(--n) * 8px); }
    .card-head, .work__blurb, .work__tags, .work__cta { flex: 0 0 auto; }

    .work__blurb {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: .9rem;
      line-height: 1.55;
      /* Exactly three lines, so the clamp lands on a baseline. */
      max-height: calc(1.55em * 3);
    }
    .work__cta { padding-top: .65rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .work__shots img, .work__arrow { transition: none; }
    .rail { scroll-behavior: auto; }
  }
</style>
